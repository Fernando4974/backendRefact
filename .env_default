# ----------------------------------------------------
# 1. Configuración del Entorno
# ----------------------------------------------------

# Define el modo de ejecución (development, staging, production)
NODE_ENV=development 
# Opcional: Puerto donde correrá el servidor
PORT=3000

# ----------------------------------------------------
# 2. Configuración de la Base de Datos (DB)
# ----------------------------------------------------

# Tipo de base de datos (PostgreSQL, mysql, sqlite, mssql, etc.)
DB_TYPE=

# Nombre del host o la IP donde se encuentra la base de datos
DB_HOST=10.1.118.152
# Puerto por defecto de la base de datos (Ej: 5432 para Postgres, 3306 para MySQL)
DB_PORT=6432

# Nombre de la base de datos a la que te quieres conectar
DB_NAME=claud_db

# Credenciales
DB_USERNAME=postgres
DB_PASSWORD=admin